# Dependencies and package-manager logs
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local release archives (original imports and generated packages)
/*.zip

# Generated screenshots, comparisons, and reports; keep the directory for tests
/verification/*
!/verification/.gitkeep

# Local environment values; example files can be shared
.env
.env.*
!.env.example
!.env.*.example

# Local caches and operating-system files
/coverage/
/.cache/
/test-results/
/playwright-report/
.DS_Store
Thumbs.db
Desktop.ini
